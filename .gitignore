.env
.venv/
__pycache__/
*.pyc
api.txt
secrets/
*.json
!config/**/*.json
!package*.json
# CI persists these so API rotation continues day-to-day
!data/history.json
!data/api_term_rotation.json
# Long-running archive (not the 15-day webpage window)
!data/archive/
!data/archive/**
data/seen_notices.json
data/last_run.json
data/raw/
reports/*
!reports/.gitkeep
# Keyword digests are small Markdown files worth keeping as a daily record
!reports/forensics/
# Ledger of notices already announced in a digest (see scripts/forensics_digest.py)
!reports/forensics/*.json
# Daily deliverables at project root (regenerated each run)
SAM-daily-*.xlsx
SAM-daily-*.html
# Published site is written by CI (and may be committed for Pages continuity)
# Keep local junk out:
.DS_Store

api.txt
../api.txt
Latest/
data/last_api_run_snippet.txt
data/_*.json
